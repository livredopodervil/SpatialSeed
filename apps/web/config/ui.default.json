{
  "schemaVersion": 1,
  "profile": "modular-workspace",
  "toolbar": {
    "layout": "horizontal",
    "storageKey": "spatialseed.ui.toolbar.v2",
    "primary": [
      "command-palette",
      "resource-search",
      "undo",
      "redo",
      "game-mode",
      "workspace-help",
      "workspace-hud-compact"
    ],
    "menus": [
      {
        "id": "project",
        "label": "Projeto",
        "items": [
          "project-new",
          "project-open",
          "project-save",
          "mesh-import-stl",
          "mesh-export-stl",
          "review",
          "pwa-install"
        ]
      },
      {
        "id": "create",
        "label": "Criar",
        "items": [
          "geometry-create",
          "experiment-lab",
          "character-import-glb"
        ]
      },
      {
        "id": "edit",
        "label": "Editar",
        "items": [
          "inspector",
          "mesh-editor",
          "duplicate-selection",
          "repeat-duplicate",
          "group-selection",
          "ungroup-selection",
          "delete-selection"
        ]
      },
      {
        "id": "program",
        "label": "Programar",
        "items": [
          "animation",
          "console",
          "procedure-editor",
          "procedure-library-open",
          "procedure-library-save"
        ]
      },
      {
        "id": "view",
        "label": "Exibir",
        "items": [
          "structure",
          "workspace-status",
          "camera-settings",
          "viewer-render-settings",
          "viewer-new",
          "scene-only",
          "viewport-fullscreen",
          "workspace-layout",
          "toolbar-layout",
          "scene-help",
          "diagnostics",
          "developer"
        ]
      }
    ],
    "hidden": [
      "add-box",
      "tool-navigate",
      "tool-select",
      "tool-translate",
      "tool-rotate",
      "tool-scale",
      "selection-replace",
      "selection-add",
      "selection-remove",
      "selection-toggle",
      "space",
      "clear-selection",
      "multi-select",
      "area-selection",
      "brush-selection",
      "lasso-selection",
      "selection-eraser",
      "pivot-policy",
      "edit-pivot"
    ]
  },
  "panels": {
    "storageKey": "spatialseed.ui.layout.v2",
    "items": {
      "selection-panel": {
        "anchor": "left",
        "bottom": 9,
        "width": 350,
        "height": 270
      },
      "outline": {
        "anchor": "right",
        "top": "toolbar",
        "width": 430,
        "height": 520
      },
      "review-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 430,
        "height": 420
      },
      "diagnostic-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 520,
        "height": 520
      },
      "camera-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 460,
        "height": 650
      },
      "viewer-render-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 500,
        "height": 720
      },
      "developer-panel": {
        "anchor": "left",
        "bottom": 12,
        "width": 720,
        "height": 520
      },
      "console-panel": {
        "anchor": "left",
        "bottom": 12,
        "width": 720,
        "height": 520
      },
      "procedure-editor-panel": {
        "anchor": "left",
        "top": "toolbar",
        "width": 760,
        "height": 680
      },
      "inspector-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 430,
        "height": 620
      },
      "geometry-create-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 430,
        "height": 620
      },
      "experiment-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 470,
        "height": 680
      },
      "animation-panel": {
        "anchor": "left",
        "top": "toolbar",
        "width": 470,
        "height": 650
      },
      "mesh-edit-panel": {
        "anchor": "right",
        "top": "toolbar",
        "width": 460,
        "height": 640
      }
    }
  },
  "shortcuts": {
    "profile": "spatialseed-0054a",
    "storageKey": "spatialseed.ui.shortcuts.v2",
    "bindings": [
      {
        "action": "command.palette.toggle",
        "chord": "Primary+P",
        "context": "global"
      },
      {
        "action": "resource.palette.toggle",
        "chord": "Primary+F",
        "context": "global"
      },
      {
        "action": "history.undo",
        "chord": "Primary+Z",
        "context": "global"
      },
      {
        "action": "history.redo",
        "chord": "Primary+Shift+Z",
        "context": "global"
      },
      {
        "action": "history.redo",
        "chord": "Primary+Y",
        "context": "global"
      },
      {
        "action": "tool.navigate",
        "chord": "Q",
        "context": "viewport"
      },
      {
        "action": "tool.select",
        "chord": "S",
        "context": "viewport"
      },
      {
        "action": "tool.translate",
        "chord": "W",
        "context": "viewport"
      },
      {
        "action": "tool.rotate",
        "chord": "E",
        "context": "viewport"
      },
      {
        "action": "tool.scale",
        "chord": "R",
        "context": "viewport"
      },
      {
        "action": "selection.duplicate",
        "chord": "Primary+C",
        "context": "global"
      },
      {
        "action": "selection.repeat",
        "chord": "Primary+D",
        "context": "global"
      },
      {
        "action": "selection.delete",
        "chord": "Delete",
        "context": "viewport"
      },
      {
        "action": "selection.delete",
        "chord": "Backspace",
        "context": "viewport"
      },
      {
        "action": "scene.toggle",
        "chord": "Tab",
        "context": "viewport"
      },
      {
        "action": "game.toggle",
        "chord": "G",
        "context": "viewport"
      },
      {
        "action": "viewport.fullscreen",
        "chord": "F",
        "context": "viewport"
      }
    ]
  },
  "presentation": {
    "transform": {
      "size": 0.8,
      "showX": true,
      "showY": true,
      "showZ": true,
      "showVertices": false,
      "vertexSize": 5
    },
    "sceneExit": {
      "corner": "top-left",
      "size": 64,
      "helpStorageKey": "spatialseed.ui.scene-help.v1"
    },
    "viewerRender": {
      "storageKey": "spatialseed.viewer.render.v1"
    },
    "editHud": {
      "storageKey": "spatialseed.edit.hud.v1"
    }
  },
  "workspace": {
    "mode": "guided",
    "defaultSection": "select",
    "sections": [
      {
        "id": "select",
        "label": "Selecionar",
        "groups": [
          "tool",
          "quick",
          "selection",
          "actions",
          "navigation"
        ],
        "hint": "Toque em um objeto. Use Adicionar para selecionar vários."
      },
      {
        "id": "create",
        "label": "Criar",
        "groups": [
          "creation",
          "drawing-target",
          "lifecycle"
        ],
        "hint": "Escolha a geometria e indique sua posição na cena."
      },
      {
        "id": "transform",
        "label": "Transformar",
        "when": "selection",
        "groups": [
          "tool",
          "frame",
          "axes",
          "reference",
          "snap"
        ],
        "hint": "Escolha Mover, Girar ou Escalar. Confira o referencial e o pivô antes de arrastar."
      },
      {
        "id": "draw",
        "label": "Desenhar",
        "groups": [
          "planar",
          "draw",
          "drawing-target",
          "lifecycle",
          "measure"
        ],
        "hint": "Defina o plano ativo, escolha uma ferramenta e desenhe na cena."
      },
      {
        "id": "mesh",
        "label": "Malha",
        "when": "mesh",
        "groups": [
          "subject",
          "tool",
          "actions",
          "session",
          "snap"
        ],
        "hint": "Escolha vértices, arestas ou faces. Ao terminar, aplique ou cancele a edição."
      },
      {
        "id": "appearance",
        "label": "Aparência",
        "groups": [
          "appearance"
        ],
        "hint": "Defina se a cor será aplicada à seleção, à próxima criação ou a ambas."
      }
    ]
  }
}
